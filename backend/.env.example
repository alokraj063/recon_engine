# Local configuration template for the recon backend.
# Full reference for every setting: docs/configuration.md
#
#   copy backend\.env.example backend\.env      (then edit backend/.env)
#
# backend/.env is git-ignored and never baked into a Docker image. Real
# environment variables always win over this file, and pytest ignores it
# entirely (tests must never pick up a real database by accident).
# On AWS there is no .env: the ECS task definition sets these, with
# DB_USER / DB_PASSWORD injected from Secrets Manager.
#
# Leaving everything commented out = local SQLite under backend/data/.

# ---------------------------------------------------------------- database
# Option 1: one URL (a bare postgresql:// is pinned to the psycopg 3 driver)
# DATABASE_URL=postgresql://postgres@localhost:55432/recon

# Option 2: separate parts, the shape ECS uses. Used only when DATABASE_URL
# is unset. Special characters in DB_PASSWORD need no escaping.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=recon
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSLMODE=require          # RDS: require (or verify-full with the RDS CA bundle)

# Run alembic migrations + seeding when the API starts. Deployed containers
# set false and run `python -m db.migrate` once per release instead.
# RUN_MIGRATIONS_ON_STARTUP=true

# ---------------------------------------------------------------- file storage
# Where uploaded source files (bronze) and run workbooks are written:
# local (default, under RECON_DATA_DIR) or s3. Reads follow each stored
# reference, so rows written under either backend stay readable.
# STORAGE_BACKEND=local
# S3_BRONZE_BUCKET=wabtec-recon-documents
# S3_RUNS_BUCKET=wabtec-recon-exports       # defaults to S3_BRONZE_BUCKET
# S3_PREFIX=recon                           # optional key prefix
# S3_KMS_KEY_ID=                            # optional; unset = bucket default encryption
# AWS_REGION=ap-south-1
# Local S3 stand-ins only (MinIO / moto server). Never set on AWS.
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# On a laptop, credentials come from your AWS profile (AWS_PROFILE=...)
# or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY. On ECS they come from the
# task role — never put keys here for a deployed service.

# ---------------------------------------------------------------- local files
# Bronze uploads, run workbooks (local backend) and SQLite files. Default backend/data
# RECON_DATA_DIR=

# ---------------------------------------------------------------- logging
# LOG_LEVEL=INFO
# Console format: text (default) or json (one JSON object per line)
# LOG_FORMAT=text
# Also write a rotating JSON log file (containers set false)
# LOG_TO_FILE=true
# Log file directory, when LOG_TO_FILE is on. Default backend/data/logs
# RECON_LOG_DIR=

# ---------------------------------------------------------------- frontend
# Built React app served at "/" by the API. Default frontend/dist; if there is
# no build there, the API runs alone (use `npm run dev` on :5173 instead).
# FRONTEND_DIST=
