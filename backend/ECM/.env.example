# Copy to backend/ECM/.env (git-ignored) and fill in. Real env vars override these.
ECM_ENV=TEST                  # TEST | PROD: picks the site layout in ecm_client/catalog.py
ECM_DOMAIN=http://host:8080   # no trailing slash needed
ECM_CLIENT_ID=
ECM_CLIENT_SECRET=
ECM_VERIFY_SSL=false          # true to verify TLS certificates
ECM_TIMEOUT_SECONDS=120
# Folder with document_kinds.toml + sites.<env>.toml. Default: ecm_client/config/
# ECM_CONFIG_DIR=
