# Local configuration / secrets (templates stay tracked)
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/
frontend/dist/

# OS / editor
.DS_Store
.vscode/
.claude/

# Playwright MCP browser-session artifacts (page snapshots, console logs)
.playwright-mcp/

# Excel lock files
~$*

# Real business data — do not publish
Receipt_reconciliation_and_IDR _ Requested_sample_documents/
Recon_*.xlsx
# golden CSVs are derived from the sample documents, so same rule
backend/tests/golden/

# Managed storage (bronze files, SQLite DB, run artifacts)
backend/data/
01_data/

# local AWS deployment scripts / IAM policies (not versioned here)
deploy/

# local copies of backend/data taken before a wipe / re-ingest
data_backup_*/
